{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "requiem-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "vars": {
    "ALLOWED_ORIGINS": "https://requiem-of-kings.vercel.app"
  },
  "ratelimits": [
    {
      "name": "MATCH_CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MATCHES", "class_name": "MatchRoom" }]
  },
  "exports": {
    "MatchRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "env": {
    "development": {
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080"
      },
      "ratelimits": [
        {
          "name": "MATCH_CREATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 50, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "MATCHES", "class_name": "MatchRoom" }]
      }
    }
  }
}
